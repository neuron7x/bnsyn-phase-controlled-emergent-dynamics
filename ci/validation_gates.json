        "required_artifacts": [
          "emergence_plot.png",
          "summary_metrics.json",
          "criticality_report.json",
          "avalanche_report.json",
          "phase_space_report.json",
          "run_manifest.json"
        ]
      },
      "evidence": {
        "artifact": "run_manifest.json",
        "source": "artifacts"
      },
      "on_fail": "FAIL"
    },
    {
      "id": "G5_manifest_valid",
      "description": "Canonical run manifest validation against planned dedicated manifest schema.",
      "status": "planned",
      "threshold": {
        "schema_ref": "planned://schemas/run_manifest.schema.json"
      },
      "evidence": {
        "artifact": "run_manifest.json",
        "source": "manifest"
      },
      "on_fail": "INCONCLUSIVE"
    },
    {
      "id": "G6_determinism_replay",
      "description": "Replay with identical seed reproduces canonical verdict inputs.",
