{
  "schema_version": "1.2.0",
  "registry": [
    {
      "id": "G1_active_spiking",
      "description": "Canonical proof path reports non-zero mean firing rate.",
      "status": "planned",
      "threshold": {
        "metric": "rate_mean_hz",
        "op": ">",
        "value": 0.0
      },
      "evidence": {
        "artifact": "summary_metrics.json",
        "source": "metrics.rate_mean_hz"
      },
      "on_fail": "FAIL"
    },
    {
      "id": "G2_rate_in_bounds",
      "description": "Canonical proof path mean firing rate stays in acceptable operational bounds.",
      "status": "planned",
      "threshold": {
        "metric": "rate_mean_hz",
        "op": "between",
        "value": [
          0.1,
          200.0
        ]
      },
      "evidence": {
        "artifact": "summary_metrics.json",
        "source": "metrics.rate_mean_hz"
      },
      "on_fail": "FAIL"
    },
    {
      "id": "G3_sigma_in_range",
      "description": "Canonical proof path sigma_mean remains in admissible range.",
      "status": "wired",
      "threshold": {
        "metric": "sigma_mean",
        "op": "between",
        "value": [
          0.7,
          1.3
        ]
      },
      "evidence": {
        "artifact": "summary_metrics.json",
        "source": "metrics.sigma_mean"
      },
      "on_fail": "FAIL"
    },
    {
      "id": "G4_core_artifacts_complete",
