      "schema": null,
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "avalanche_fit_report.json",
      "category": "report",
      "description": "Avalanche fit evidence",
      "schema": "avalanche_fit_report",
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "robustness_report.json",
      "category": "report",
      "description": "Deterministic robustness envelope report",
      "schema": "robustness_report",
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "envelope_report.json",
      "category": "report",
      "description": "Admissibility-band envelope report",
      "schema": "envelope_report",
