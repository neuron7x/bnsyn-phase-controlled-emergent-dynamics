      "schema": "run_manifest",
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "proof_report.json",
      "category": "report",
      "description": "Proof verdict report",
      "schema": "proof_report",
      "required_in_modes": [
        "canonical-export-proof"
      ]
    },
    {
      "filename": "traces.npz",
      "category": "trace",
      "description": "Optional raw trace archive",
      "schema": null,
      "required_in_modes": []
    },
    {
      "filename": "raster_plot.png",
      "category": "visual",
      "description": "Optional raster plot",
      "schema": null,
      "required_in_modes": []
    },
    {
      "filename": "population_rate_plot.png",
      "category": "visual",
      "description": "Optional population-rate plot",
      "schema": null,
      "required_in_modes": []
    }
  ],
  "required_schema_set": [
    {
      "id": "run_manifest",
      "path": "schemas/run-manifest.schema.json",
      "schema_version": "1.0.0"
    },
    {
      "id": "proof_report",
      "path": "schemas/proof-report.schema.json",
      "schema_version": "1.1.0"
    },
    {
      "id": "avalanche_report",
      "path": "schemas/avalanche-report.schema.json",
      "schema_version": "1.0.0"
    },
    {
      "id": "avalanche_fit_report",
      "path": "schemas/avalanche-fit-report.schema.json",
      "schema_version": "1.0.0"
    },
    {
      "id": "robustness_report",
      "path": "schemas/robustness-report.schema.json",
      "schema_version": "1.0.0"
    },
    {
      "id": "envelope_report",
      "path": "schemas/envelope-report.schema.json",
      "schema_version": "1.0.0"
    },
    {
      "id": "phase_space_report",
      "path": "schemas/phase-space-report.schema.json",
      "schema_version": "1.1.0"
    }
  ],
  "validation_rules": [
    "Canonical command and bundle mode commands are deterministic and fixed.",
    "Manifest artifacts must include SHA-256 hashes for required artifacts.",
    "JSON artifacts with schema references must validate against required_schema_set.",
    "Bundle mode required_artifacts must be enforced without permissive fallback."
  ],
  "bundle_invariants": [
    "run_manifest.json self-hash is computed with normalized self placeholder.",
    "canonical-base mode forbids proof_report.json in manifest artifacts.",
    "canonical-export-proof mode requires proof_report.json in manifest artifacts."
  ],
  "compatibility": {
    "authoritative": true,
    "notes": "This JSON is the only canonical proof contract source; all consumers must derive from it or be validated against it."
  }
}
