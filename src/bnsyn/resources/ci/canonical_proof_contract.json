{
  "contract_name": "bnsyn-canonical-proof-contract",
  "contract_version": "1.0.0",
  "canonical_command": "bnsyn run --profile canonical --plot --export-proof",
  "canonical_entrypoint": "bnsyn run",
  "artifact_dir": {
    "default": "artifacts/canonical_run",
    "cli_argument": "--output"
  },
  "bundle_modes": {
    "canonical-base": {
      "export_proof": false,
      "command": "bnsyn run --profile canonical --plot"
    },
    "canonical-export-proof": {
      "export_proof": true,
      "command": "bnsyn run --profile canonical --plot --export-proof"
    }
  },
  "required_artifacts": {
    "canonical-base": [
      "emergence_plot.png",
      "summary_metrics.json",
      "criticality_report.json",
      "avalanche_report.json",
      "phase_space_report.json",
      "population_rate_trace.npy",
      "sigma_trace.npy",
      "coherence_trace.npy",
      "phase_space_rate_sigma.png",
      "phase_space_rate_coherence.png",
      "phase_space_activity_map.png",
      "avalanche_fit_report.json",
      "robustness_report.json",
      "envelope_report.json",
      "run_manifest.json"
    ],
    "canonical-export-proof": [
      "emergence_plot.png",
      "summary_metrics.json",
      "criticality_report.json",
      "avalanche_report.json",
      "phase_space_report.json",
      "population_rate_trace.npy",
      "sigma_trace.npy",
      "coherence_trace.npy",
      "phase_space_rate_sigma.png",
      "phase_space_rate_coherence.png",
      "phase_space_activity_map.png",
      "avalanche_fit_report.json",
      "robustness_report.json",
      "envelope_report.json",
      "run_manifest.json",
      "proof_report.json"
    ]
  },
  "optional_artifacts": [
    "traces.npz",
    "raster_plot.png",
    "population_rate_plot.png"
  ],
  "artifacts": [
    {
      "filename": "emergence_plot.png",
      "category": "visual",
      "description": "Primary emergence visual",
      "schema": null,
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "summary_metrics.json",
      "category": "metrics",
      "description": "Top-level numeric summary",
      "schema": null,
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "criticality_report.json",
      "category": "report",
      "description": "Criticality metrics report",
      "schema": null,
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "avalanche_report.json",
      "category": "report",
      "description": "Avalanche event metrics report",
      "schema": "avalanche_report",
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "phase_space_report.json",
      "category": "report",
      "description": "Phase space metrics report",
      "schema": "phase_space_report",
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "population_rate_trace.npy",
      "category": "trace",
      "description": "Population-rate trace",
      "schema": null,
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "sigma_trace.npy",
      "category": "trace",
      "description": "Sigma trace",
      "schema": null,
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "coherence_trace.npy",
      "category": "trace",
      "description": "Coherence trace",
      "schema": null,
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "phase_space_rate_sigma.png",
      "category": "visual",
      "description": "(rate,sigma) trajectory figure",
      "schema": null,
      "required_in_modes": [
        "canonical-base",
        "canonical-export-proof"
      ]
    },
    {
      "filename": "phase_space_rate_coherence.png",
      "category": "visual",
