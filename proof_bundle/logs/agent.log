   102	
   103	        # subprocess used for controlled dashboard launch (no shell).
   104	        import subprocess  # nosec B404
   105	        import sys
   106	
   107	        # Find the interactive.py script
   108	        script_path = Path(__file__).parent / "viz" / "interactive.py"
   109	        if not script_path.exists():
   110	            print(f"Error: Interactive dashboard not found at {script_path}")
   111	            return 1
   112	        if importlib.util.find_spec("streamlit") is None:
   113	            print('Error: Streamlit is not installed. Install with: pip install -e ".[viz]"')
   114	            return 1
   115	
   116	        print("🚀 Launching interactive dashboard...")
   117	        print("   Press Ctrl+C to stop")
   118	        try:
   119	            # Fixed module invocation without shell; inputs are local paths only.
   120	            result = subprocess.run(  # nosec B603
   121	                [sys.executable, "-m", "streamlit", "run", str(script_path)]
   122	            )
   123	            if result.returncode != 0:
   124	                print(f"Error: Dashboard exited with code {result.returncode}")
   125	                return 1
   126	            return 0
   127	        except KeyboardInterrupt:
   128	            print("\n✓ Dashboard stopped")
   129	            return 0
   130	        except Exception as e:
   131	            print(f"Error launching dashboard: {e}")
   132	            return 1
