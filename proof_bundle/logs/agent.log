    38	def _get_package_version() -> str:
    39	    """Return the installed package version with a safe fallback."""
    40	    version: str | None = None
    41	    try:
    42	        version = importlib.metadata.version("bnsyn")
    43	    except importlib.metadata.PackageNotFoundError:
    44	        version = None
    45	    except Exception as exc:
    46	        warnings.warn(f"Failed to read package version: {exc}", stacklevel=2)
    47	        version = None
    48	
    49	    if version:
    50	        return version
    51	
    52	    pyproject_path = Path(__file__).resolve().parents[2] / "pyproject.toml"
    53	    if pyproject_path.exists():
    54	        try:
    55	            data = tomllib.loads(pyproject_path.read_text(encoding="utf-8"))
    56	        except (OSError, tomllib.TOMLDecodeError):
    57	            return "unknown"
    58	        version = data.get("project", {}).get("version")
    59	        if isinstance(version, str) and version:
    60	            return version
    61	
    62	    return "unknown"
