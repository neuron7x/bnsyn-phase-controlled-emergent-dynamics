   225	def _run_emergence_once(
   226	    *,
   227	    out_dir: Path,
   228	    steps: int,
   229	    dt_ms: float,
   230	    seed: int,
   231	    N: int,
   232	    external_current_pA: float,
   233	    artifact_name: str,
   234	) -> dict[str, Any]:
   235	    """Run one emergence simulation and return metrics + artifact path."""
   236	    out_dir.mkdir(parents=True, exist_ok=True)
   237	    run_metrics = run_simulation(
   238	        steps=steps,
   239	        dt_ms=dt_ms,
   240	        seed=seed,
   241	        N=N,
   242	        external_current_pA=external_current_pA,
   243	        artifact_dir=out_dir,
   244	    )
   245	    canonical_npz = out_dir / f"run_{seed}.npz"
   246	    target_npz = out_dir / artifact_name
   247	    canonical_npz.replace(target_npz)
   248	    return {
   249	        "external_current_pA": external_current_pA,
   250	        "metrics": run_metrics,
   251	        "artifact_npz": str(target_npz),
   252	    }
