   205	
   206	def _compute_steps_exact(duration_ms: float, dt_ms: float) -> int:
   207	    """Convert duration/dt to integer steps without silent truncation."""
   208	    if dt_ms <= 0.0:
   209	        raise ValueError("dt-ms must be greater than 0")
   210	    if duration_ms <= 0.0:
   211	        raise ValueError("duration-ms must be greater than 0")
   212	    ratio = duration_ms / dt_ms
   213	    rounded = round(ratio)
   214	    if abs(ratio - rounded) > 1e-9:
   215	        raise ValueError("duration-ms must be an integer multiple of dt-ms")
   216	    return int(rounded)
   217	
