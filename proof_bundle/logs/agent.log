   255	def _validate_emergence_args(args: argparse.Namespace, *, require_current: bool) -> int:
   256	    """Validate shared emergence CLI arguments and return exact steps."""
   257	    if args.N <= 0:
   258	        raise ValueError("N must be greater than 0")
   259	    if args.seed <= 0:
   260	        raise ValueError("seed must be greater than 0")
   261	    steps = _compute_steps_exact(args.duration_ms, args.dt_ms)
   262	    if require_current and not math.isfinite(float(args.external_current_pA)):
   263	        raise ValueError("external-current-pA must be a finite real number")
   264	    return steps
